# Nostr VOIP Environment Variables
# Copy this file to .env and update with your values

# ===========================================
# Application Configuration
# ===========================================

# Application environment
NODE_ENV=development

# Application name and version
VITE_APP_NAME=Nostr VOIP
VITE_APP_VERSION=1.0.0

# ===========================================
# Nostr Configuration
# ===========================================

# Default Nostr relay for signaling
VITE_DEFAULT_RELAY=wss://relay.nostr.band

# Additional relays for follows and events
VITE_FOLLOWS_RELAY=wss://relay.damus.io,wss://nos.lol

# ===========================================
# WebRTC Configuration
# ===========================================

# STUN server for NAT traversal
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# Additional STUN servers (comma-separated)
VITE_STUN_SERVERS=stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# TURN server for restrictive networks (optional)
VITE_TURN_SERVER=

# TURN server authentication (if using TURN)
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# TURN server protocol (udp or tcp)
VITE_TURN_PROTOCOL=udp

# ===========================================
# Features Configuration
# ===========================================

# Enable experimental features
VITE_EXPERIMENTAL_FEATURES=false

# Enable call recording (client-side)
VITE_ENABLE_RECORDING=false

# Enable call analytics
VITE_ENABLE_ANALYTICS=false

# ===========================================
# UI Configuration
# ===========================================

# Theme (light, dark, or auto)
VITE_THEME=auto

# Language for UI
VITE_LANGUAGE=en

# ===========================================
# Development Configuration
# ===========================================

# Enable development mode
VITE_DEV_MODE=false

# Enable hot reload
VITE_HOT_RELOAD=true

# Development server host
VITE_DEV_HOST=localhost

# Development server port
VITE_DEV_PORT=5173

# ===========================================
# Docker Configuration
# ===========================================

# Docker Compose project name
COMPOSE_PROJECT_NAME=nostr-voip

# Docker Compose file
COMPOSE_FILE=docker-compose.yml

# Docker network name
DOCKER_NETWORK=nostr-voip-network

# ===========================================
# Production Configuration
# ===========================================

# Production URL
VITE_PROD_URL=https://your-domain.com

# Production API URL
VITE_API_URL=https://api.your-domain.com

# Production CDN URL (for static assets)
VITE_CDN_URL=https://cdn.your-domain.com

# ===========================================
# Security Configuration
# ===========================================

# Enable HTTPS in production
VITE_HTTPS=true

# SSL certificate path
VITE_SSL_CERT=/etc/ssl/certs/cert.pem

# SSL private key path
VITE_SSL_KEY=/etc/ssl/private/key.pem

# ===========================================
# Logging Configuration
# ===========================================

# Log level (debug, info, warn, error)
VITE_LOG_LEVEL=info

# Enable console logging
VITE_CONSOLE_LOG=true

# Enable remote logging
VITE_REMOTE_LOG=false

# Remote logging endpoint
VITE_REMOTE_LOG_ENDPOINT=https://logs.your-domain.com

# ===========================================
# Performance Configuration
# ===========================================

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Performance monitoring endpoint
VITE_PERFORMANCE_ENDPOINT=https://perf.your-domain.com

# Cache settings
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=3600

# ===========================================
# Advanced Configuration
# ===========================================

# Maximum concurrent calls
VITE_MAX_CONCURRENT_CALLS=1

# Call timeout in seconds
VITE_CALL_TIMEOUT=300

# Heartbeat interval in seconds
VITE_HEARTBEAT_INTERVAL=30

# Reconnection attempts
VITE_MAX_RECONNECTION_ATTEMPTS=5

# Reconnection delay in milliseconds
VITE_RECONNECTION_DELAY=1000

# ===========================================
# Feature Flags
# ===========================================

# Enable video calls (future feature)
VITE_ENABLE_VIDEO=false

# Enable group calls (future feature)
VITE_ENABLE_GROUP_CALLS=false

# Enable screen sharing (future feature)
VITE_ENABLE_SCREEN_SHARING=false

# Enable file transfer during calls (future feature)
VITE_ENABLE_FILE_TRANSFER=false

# Enable chat during calls (future feature)
VITE_ENABLE_CALL_CHAT=false

# Enable virtual background (future feature)
VITE_ENABLE_VIRTUAL_BACKGROUND=false

# Enable noise cancellation
VITE_ENABLE_NOISE_CANCELLATION=true

# Enable echo cancellation
VITE_ENABLE_ECHO_CANCELLATION=true

# Enable automatic gain control
VITE_ENABLE_AUTO_GAIN_CONTROL=true

# ===========================================
# LLM Secretary Configuration (Future)
# ===========================================

# Enable AI call screening
VITE_ENABLE_AI_SCREENING=false

# AI screening model endpoint
VITE_AI_SCREENING_ENDPOINT=https://ai.your-domain.com/screen

# AI transcription endpoint
VITE_AI_TRANSCRIPTION_ENDPOINT=https://ai.your-domain.com/transcribe

# AI voicemail endpoint
VITE_AI_VOICEMAIL_ENDPOINT=https://ai.your-domain.com/voicemail

# AI call summary endpoint
VITE_AI_SUMMARY_ENDPOINT=https://ai.your-domain.com/summary

# ===========================================
# Local Network Configuration
# ===========================================

# Enable local network discovery
VITE_LOCAL_DISCOVERY=true

# Local network port
VITE_LOCAL_PORT=8080

# Enable mDNS/Bonjour for local discovery
VITE_ENABLE_MDNS=true

# Local network name
VITE_LOCAL_NAME=nostr-voip-local

# ===========================================
# Mobile Configuration
# ===========================================

# Enable mobile optimizations
VITE_MOBILE_OPTIMIZATIONS=true

# Enable push notifications
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# Push notification service worker
VITE_PUSH_SERVICE_WORKER=/sw.js

# ===========================================
# Accessibility Configuration
# ===========================================

# Enable screen reader support
VITE_ENABLE_SCREEN_READER=true

# Enable keyboard navigation
VITE_ENABLE_KEYBOARD_NAVIGATION=true

# Enable high contrast mode
VITE_ENABLE_HIGH_CONTRAST=false

# Enable reduced motion
VITE_ENABLE_REDUCED_MOTION=false

# ===========================================
# Analytics and Monitoring
# ===========================================

# Google Analytics ID
VITE_GA_ID=

# Plausible Analytics domain
VITE_PLAUSIBLE_DOMAIN=

# Sentry DSN for error tracking
VITE_SENTRY_DSN=

# ===========================================
# Social and Sharing
# ===========================================

# Enable social sharing
VITE_ENABLE_SOCIAL_SHARING=true

# Twitter handle
VITE_TWITTER_HANDLE=@nostr_voip

# GitHub repository
VITE_GITHUB_REPO=https://github.com/your-username/nostr-voip

# ===========================================
# Legal and Compliance
# ===========================================

# Privacy policy URL
VITE_PRIVACY_POLICY_URL=https://your-domain.com/privacy

# Terms of service URL
VITE_TERMS_OF_SERVICE_URL=https://your-domain.com/terms

# Cookie policy URL
VITE_COOKIE_POLICY_URL=https://your-domain.com/cookies

# ===========================================
# Development Only (Remove in Production)
# ===========================================

# Mock WebRTC for development
VITE_MOCK_WEBRTC=true

# Enable debug logging
VITE_DEBUG=true

# Enable development tools
VITE_DEV_TOOLS=true

# Enable hot module replacement
VITE_HMR=true

# ===========================================
# Notes
# ===========================================
#
# 1. Copy this file to .env and update with your actual values
# 2. Never commit .env file to version control
# 3. Use different values for development and production
# 4. For production, set NODE_ENV=production
# 5. For Docker, use docker-compose environment overrides
# 6. TURN server credentials should be kept secure
# 7. SSL certificates are required for WebRTC in production
# 8. Local network discovery works best on same subnet
# 9. AI features are experimental and require additional setup
# 10. Mobile optimizations may reduce functionality on older devices
#